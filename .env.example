# Copy to .env and fill in your keys. Never commit real credentials.

# --- LLM (optional) ---
NVIDIA_API_KEY=
KAVACH_USE_LLM=0
# KAVACH_MODEL=deepseek-ai/deepseek-v4-flash-0731
# KAVACH_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Guardrails ---
# GUARDRAILS=on

# --- Payment rail ---
# simulated = local wallet only (default for demo / eval / TUI)
# razorpay  = after kernel allow, create a Razorpay test-mode order
KAVACH_PAYMENT_RAIL=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: webhook secret from Razorpay dashboard (local demo can use client callback instead)
RAZORPAY_WEBHOOK_SECRET=
