# Copy to .env and fill in your keys. Never commit real credentials.

# --- LLM (optional) ---
# Default cloud model: Claude Haiku. Paste your Anthropic key, then set KAVACH_USE_LLM=1.
ANTHROPIC_API_KEY=
KAVACH_USE_LLM=0
# KAVACH_LLM_BACKEND=anthropic
# KAVACH_MODEL=claude-haiku-4-5

# Local Llama via Ollama (optional switch)
# KAVACH_USE_OLLAMA=1
# KAVACH_LLM_BACKEND=ollama
# KAVACH_MODEL=llama3.2
# OLLAMA_HOST=http://127.0.0.1:11434

# --- Guardrails ---
# GUARDRAILS=on

# --- Payment rail ---
# simulated = local wallet only (default for demo / eval / TUI)
# razorpay  = after kernel allow, create a Razorpay test-mode order
KAVACH_PAYMENT_RAIL=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: webhook secret from Razorpay dashboard (local demo can use client callback instead)
RAZORPAY_WEBHOOK_SECRET=
